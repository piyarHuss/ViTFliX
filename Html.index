                    <!-- ORIGINAL SIMPLE TEXT BUTTON FOR RECORD -->
                    <button onclick="openRecordsModal()" class="text-xs text-gray-300 font-semibold hover:underline">Record &gt;</button>
                </div>

                <div class="bg-amber-100 text-amber-900 border border-amber-300 rounded-xl px-3 py-2 flex items-center gap-2 text-xs font-semibold shadow-sm">
                    <i class="fas fa-volume-high text-amber-600 animate-pulse"></i>
                    <span id="wallet-ticker">18:51 BN**PJ successfully withdraws ₹20</span>
                </div>

                <div class="bg-gradient-to-r from-red-600 to-rose-500 rounded-2xl p-5 text-white shadow-xl space-y-4 glow-red">
                    <div>
                        <div class="flex items-center gap-2">
                            <i class="fas fa-coins text-yellow-300 text-2xl coin-spin"></i>
                            <span id="wallet-coins-count" class="text-3xl font-black">108,176</span>
                            <span class="text-sm font-bold text-yellow-200 ml-1">≈ ₹ <span id="wallet-rupees-count">10.82</span></span>
                        </div>
                    </div>

                    <div class="flex items-center gap-6 text-xs border-t border-white/20 pt-3 text-white/90 font-medium">
                        <div>Pending: <span class="font-bold">₹ 0</span></div>
                        <div>Withdrawn: <span class="font-bold" id="total-withdrawn-text">₹ 0.00</span></div>
                    </div>
                </div>

                <div class="bg-rose-50 border border-rose-200 rounded-2xl p-3.5 flex items-center justify-between shadow-sm">
                    <div class="text-xs text-rose-950 font-bold">
                        <p>Tips: Invite Friends to get <span class="text-red-600 font-black">₹5+10%+10%</span></p>
                    </div>
                    <button onclick="shareMovie()" class="bg-gradient-to-r from-red-500 to-rose-500 text-white text-xs font-bold px-4 py-1.5 rounded-full shadow hover:scale-105 transition">Go</button>
                </div>

                <div class="space-y-3">
                    <div class="flex gap-6 border-b border-white/10 text-sm font-bold pb-2">
                        <button class="text-gray-400 hover:text-white">Phone Bill</button>
                        <button class="text-brand-red border-b-2 border-brand-red pb-2 -mb-2">Transfer</button>
                    </div>

                    <div class="grid grid-cols-3 gap-3 pt-2">
                        <div onclick="selectWithdrawCard(this, 10, 100000)" class="withdraw-card withdraw-card-active bg-brand-card border border-brand-border rounded-xl p-3.5 text-center cursor-pointer transition">
                            <p class="text-lg font-black text-white">₹10</p>
                            <p class="text-[10px] text-yellow-400 font-bold flex items-center justify-center gap-1 mt-1"><i class="fas fa-coins text-[8px]"></i> 100,000</p>
                        </div>
                        <div onclick="selectWithdrawCard(this, 20, 200000)" class="withdraw-card bg-brand-card border border-brand-border rounded-xl p-3.5 text-center cursor-pointer transition">
                            <p class="text-lg font-black text-white">₹20</p>
                            <p class="text-[10px] text-yellow-400 font-bold flex items-center justify-center gap-1 mt-1"><i class="fas fa-coins text-[8px]"></i> 200,000</p>
                        </div>
                        <div onclick="selectWithdrawCard(this, 50, 500000)" class="withdraw-card bg-brand-card border border-brand-border rounded-xl p-3.5 text-center cursor-pointer transition">
                            <p class="text-lg font-black text-white">₹50</p>
                            <p class="text-[10px] text-yellow-400 font-bold flex items-center justify-center gap-1 mt-1"><i class="fas fa-coins text-[8px]"></i> 500,000</p>
                        </div>
                        <div onclick="selectWithdrawCard(this, 105, 1050000)" class="withdraw-card bg-brand-card border border-brand-border rounded-xl p-3.5 text-center cursor-pointer transition">
                            <p class="text-lg font-black text-white">₹105</p>
                            <p class="text-[10px] text-yellow-400 font-bold flex items-center justify-center gap-1 mt-1"><i class="fas fa-coins text-[8px]"></i> 1,050,000</p>
                        </div>
                        <div onclick="selectWithdrawCard(this, 200, 2000000)" class="withdraw-card bg-brand-card border border-brand-border rounded-xl p-3.5 text-center cursor-pointer transition">
                            <p class="text-lg font-black text-white">₹200</p>
                            <p class="text-[10px] text-yellow-400 font-bold flex items-center justify-center gap-1 mt-1"><i class="fas fa-coins text-[8px]"></i> 2,000,000</p>
                        </div>
                        <div onclick="selectWithdrawCard(this, 500, 5000000)" class="withdraw-card bg-brand-card border border-brand-border rounded-xl p-3.5 text-center cursor-pointer transition">
                            <p class="text-lg font-black text-white">₹500</p>
                            <p class="text-[10px] text-yellow-400 font-bold flex items-center justify-center gap-1 mt-1"><i class="fas fa-coins text-[8px]"></i> 5,000,000</p>
                        </div>
                    </div>
                </div>

                <div class="text-[11px] text-gray-400 space-y-1.5 pt-2 leading-relaxed">
                    <p>- Earn cash rewards by watching videos & tasks!</p>
                    <p>- Fill withdrawal info accurately. Processed within 24 hours.</p>
                </div>

                <div class="pt-2">
                    <button onclick="openWithdrawModal()" class="w-full bg-rose-300 text-rose-900 font-black py-3.5 rounded-full text-base shadow-lg hover:bg-rose-400 transition">
                        Withdraw
                    </button>
                </div>
            </main>

        </div>

    </div>

    <!-- MOBILE BOTTOM NAVIGATION -->
    <nav class="md:hidden fixed bottom-0 left-0 right-0 z-50 glass-panel border-t border-brand-border px-6 py-2.5 flex justify-around items-center">
        <button onclick="switchView('movies')" id="mobile-nav-movies" class="flex flex-col items-center gap-1 text-brand-red">
            <i class="fas fa-film text-lg"></i>
            <span class="text-[10px] font-bold">Movies</span>
        </button>
        <button onclick="switchView('shorts')" id="mobile-nav-shorts" class="flex flex-col items-center gap-1 text-gray-400 hover:text-white">
            <i class="fas fa-bolt text-lg"></i>
            <span class="text-[10px] font-bold">Shorts</span>
        </button>
        <button onclick="switchView('cash')" id="mobile-nav-cash" class="flex flex-col items-center gap-1 text-gray-400 hover:text-white">
            <i class="fas fa-wallet text-lg text-brand-gold"></i>
            <span class="text-[10px] font-bold">Cash</span>
        </button>
    </nav>


    <!-- JavaScript Engine -->
    <script>
        // --- Supabase Config ---
        const SUPABASE_URL = "https://ipawpmiuaqxfnxjgigeh.supabase.co";
        const SUPABASE_KEY = "sb_publishable_BgEm2LyCKPvGdB8gLjKeUw_GiG7kU61";
        const _supabase = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

        let coins = 108176;
        let totalWithdrawn = 0;
        let userId = localStorage.getItem('vitflix_user_id') || "user_" + Math.floor(1000 + Math.random() * 9000);
        localStorage.setItem('vitflix_user_id', userId);

        let currentMovie = null;
        let allMoviesList = [];
        let allShortsList = [];
        let totalWatchedSeconds = 0;
        let watchTimerInterval = null;

        let selectedRupees = 10;
        let selectedCoinsReq = 100000;

        let isFullScreenActive = false;

        let shortsWatchedCount = 0;
        let lastScrollTop = 0;

        const milestones = [
            { id: 0, mins: 2, seconds: 120, reward: 800, claimed: false },
            { id: 1, mins: 10, seconds: 600, reward: 2000, claimed: false },
            { id: 2, mins: 20, seconds: 1200, reward: 4000, claimed: false },
            { id: 3, mins: 30, seconds: 1800, reward: 6000, claimed: false },
            { id: 4, mins: 60, seconds: 3600, reward: 10000, claimed: false },
            { id: 5, mins: 180, seconds: 10800, reward: 16000, claimed: false }
        ];

        // --- LOCAL STORAGE KEYS FOR PERSISTENT WATCH PROGRESS ---
        const LS_WATCH_SECS = 'vitflix_watch_secs_' + userId;
        const LS_CLAIMED_MAP = 'vitflix_claimed_milestones_' + userId;
        const LS_COMPLETED_TIME = 'vitflix_all_claimed_time_' + userId;

        function loadSavedWatchProgress() {
            // Restore watched time
            const savedSecs = localStorage.getItem(LS_WATCH_SECS);
            if (savedSecs !== null) {
                totalWatchedSeconds = parseInt(savedSecs, 10) || 0;
            }

            // Restore claimed status
            const savedClaimed = localStorage.getItem(LS_CLAIMED_MAP);
            if (savedClaimed) {
                try {
                    const claimedObj = JSON.parse(savedClaimed);
                    milestones.forEach(m => {
                        if (claimedObj[m.id] !== undefined) {
                            m.claimed = claimedObj[m.id];
                        }
                    });
                } catch(e) {}
            }

            // Check if ALL milestones are claimed and 3 hours passed
            const completedTimestamp = localStorage.getItem(LS_COMPLETED_TIME);
            if (completedTimestamp) {
                const elapsedMs = Date.now() - parseInt(completedTimestamp, 10);
                const threeHoursMs = 3 * 60 * 60 * 1000; // 3 Hours in Milliseconds

                if (elapsedMs >= threeHoursMs) {
                    // Reset progress after 3 hours of full completion
                    resetWatchProgress();
                    return;
                }
            }

            updateWatchTimelineUI();
        }

        function saveWatchProgress() {
            localStorage.setItem(LS_WATCH_SECS, totalWatchedSeconds);
            
            const claimedObj = {};
            milestones.forEach(m => { claimedObj[m.id] = m.claimed; });
            localStorage.setItem(LS_CLAIMED_MAP, JSON.stringify(claimedObj));

            // Check if all milestones are claimed
            const allClaimed = milestones.every(m => m.claimed);
            if (allClaimed && !localStorage.getItem(LS_COMPLETED_TIME)) {
                localStorage.setItem(LS_COMPLETED_TIME, Date.now());
            }
        }

        function resetWatchProgress() {
            totalWatchedSeconds = 0;
            milestones.forEach(m => m.claimed = false);
            localStorage.removeItem(LS_WATCH_SECS);
            localStorage.removeItem(LS_CLAIMED_MAP);
            localStorage.removeItem(LS_COMPLETED_TIME);
            updateWatchTimelineUI();
        }

        const defaultShorts = [
            {
                id: "s1",
                creator: "@MovieZone",
                title: "Top Action Scene 2024 🔥 #shorts",
                video_url: "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4"
            },
            {
                id: "s2",
                creator: "@ActionCentral",
                title: "Sci-Fi Stunt Scene 🚀",
                video_url: "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerEscapes.mp4"
            },
            {
                id: "s3",
                creator: "@ComedyClips",
                title: "Funny Clips Compilation 😂",
                video_url: "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerFun.mp4"
            }
        ];

        const tickerMessages = [
            "18:51 BN**PJ successfully withdrew ₹20",
            "18:52 Rahul_99 successfully withdrew ₹50",
            "18:54 Aman_K successfully withdrew ₹10"
        ];
        let tickerIndex = 0;
        setInterval(() => {
            tickerIndex = (tickerIndex + 1) % tickerMessages.length;
            const tickerEl = document.getElementById('payout-ticker');
            const walletTickerEl = document.getElementById('wallet-ticker');
            if (tickerEl) tickerEl.textContent = tickerMessages[tickerIndex];
            if (walletTickerEl) walletTickerEl.textContent = tickerMessages[tickerIndex];
        }, 3500);

        // RECORDS MODAL (Withdrawal History)
        function openRecordsModal() {
            document.getElementById('records-modal').classList.remove('hidden');
            fetchUserWithdrawalRecords();
        }

        function closeRecordsModal() {
            document.getElementById('records-modal').classList.add('hidden');
        }

        async function fetchUserWithdrawalRecords() {
            const listContainer = document.getElementById('records-list');
            listContainer.innerHTML = `<div class="text-center py-6 text-xs text-gray-400"><i class="fas fa-circle-notch fa-spin text-brand-red mr-2"></i>Loading records...</div>`;

            try {
                const { data, error } = await _supabase.from('withdrawals').select('*').eq('user_id', userId).order('created_at', { ascending: false });

                if (error || !data || data.length === 0) {
                    listContainer.innerHTML = `<div class="text-center py-8 text-xs text-gray-500">No withdrawal records found yet.</div>`;
                    return;
                }

                listContainer.innerHTML = data.map(rec => {
                    let badgeClass = "bg-yellow-500/20 text-yellow-400 border-yellow-500/30";
                    let statusText = "Pending";

                    if (rec.status === 'Approved') {
                        badgeClass = "bg-green-500/20 text-green-400 border-green-500/30";
                        statusText = "Received (Mila)";
                    } else if (rec.status === 'Rejected') {
                        badgeClass = "bg-red-500/20 text-red-400 border-red-500/30";
                        statusText = "Rejected (Refunded)";
                    }

                    return `
                        <div class="bg-black/50 border border-white/10 rounded-xl p-3.5 flex items-center justify-between text-xs">
                            <div class="space-y-1">
                                <div class="font-extrabold text-white text-sm">₹${rec.amount_inr} Payout</div>
                                <div class="text-[10px] text-gray-400 font-mono">${rec.payment_info}</div>
                                <div class="text-[9px] text-gray-500">${new Date(rec.created_at).toLocaleDateString()} ${new Date(rec.created_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</div>
                            </div>
                            <div class="text-right space-y-1">
                                <span class="px-2.5 py-1 rounded-full text-[9px] font-extrabold uppercase border ${badgeClass}">${statusText}</span>
                                <div class="text-[10px] text-brand-gold font-bold"><i class="fas fa-coins text-[8px]"></i> ${rec.coins_used ? rec.coins_used.toLocaleString() : 0}</div>
                            </div>
                        </div>
                    `;
                }).join('');
            } catch(e) {
                listContainer.innerHTML = `<div class="text-center py-6 text-xs text-red-400">Failed to load records.</div>`;
            }
        }

        function makeVideoFullScreen() {
            const wrapper = document.getElementById('video-wrapper');
            const btnIcon = document.getElementById('fs-btn-icon');

            if (!isFullScreenActive) {
                wrapper.classList.add('fullscreen-active');
                
                try {
                    if (wrapper.requestFullscreen) wrapper.requestFullscreen();
                    else if (wrapper.webkitRequestFullscreen) wrapper.webkitRequestFullscreen();
                } catch(e) {}

                btnIcon.className = "fas fa-compress text-brand-gold";
                isFullScreenActive = true;
                showToast('📺 Full Screen Mode');
            } else {
                wrapper.classList.remove('fullscreen-active');
                
                try {
                    if (document.exitFullscreen) document.exitFullscreen();
                    else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
                } catch(e) {}

                btnIcon.className = "fas fa-expand text-brand-gold";
                isFullScreenActive = false;
                showToast('📺 Normal Mode');
            }
        }

        function openDrawerMenu() { document.getElementById('menu-drawer').classList.remove('hidden'); }
        function closeDrawerMenu() { document.getElementById('menu-drawer').classList.add('hidden'); }

        function switchView(viewName) {
            const moviesView = document.getElementById('view-movies');
            const shortsView = document.getElementById('view-shorts');
            const cashView = document.getElementById('view-cash');
            
            const mobNavMovies = document.getElementById('mobile-nav-movies');
            const mobNavShorts = document.getElementById('mobile-nav-shorts');
            const mobNavCash = document.getElementById('mobile-nav-cash');

            moviesView.classList.add('hidden');
            shortsView.classList.add('hidden');
            cashView.classList.add('hidden');

            mobNavMovies.className = "flex flex-col items-center gap-1 text-gray-400 hover:text-white";
            mobNavShorts.className = "flex flex-col items-center gap-1 text-gray-400 hover:text-white";
            mobNavCash.className = "flex flex-col items-center gap-1 text-gray-400 hover:text-white";

            if (viewName === 'movies') {
                moviesView.classList.remove('hidden');
                mobNavMovies.className = "flex flex-col items-center gap-1 text-brand-red";
            } else if (viewName === 'shorts') {
                shortsView.classList.remove('hidden');
                mobNavShorts.className = "flex flex-col items-center gap-1 text-brand-red";
                renderShortsFeed();
            } else if (viewName === 'cash') {
                cashView.classList.remove('hidden');
                mobNavCash.className = "flex flex-col items-center gap-1 text-brand-gold";
            }
        }

        function renderShortsFeed(force = false) {
            const feed = document.getElementById('reels-feed');
            if (feed.children.length > 0 && !force) return;

            const listToRender = (allShortsList.length > 0) ? allShortsList : defaultShorts;

            feed.innerHTML = listToRender.map((short, index) => {
                const url = short.video_url || "";
                const ytId = getYouTubeId(url);
                const dmId = getDailymotionId(url);

                let playerHTML = "";

                if (ytId) {
                    playerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1&mute=0&controls=0&loop=1&playlist=${ytId}&playsinline=1" allow="autoplay; encrypted-media" class="absolute inset-0 w-full h-full object-cover border-0 z-10"></iframe>`;
                } else if (dmId) {
                    playerHTML = `<iframe src="https://www.dailymotion.com/embed/video/${dmId}?autoplay=1&ui-logo=0" allow="autoplay; fullscreen" class="absolute inset-0 w-full h-full object-cover border-0 z-10"></iframe>`;
                } else if (url.includes('drive.google.com')) {
                    let driveUrl = url.replace('/view', '/preview');
                    playerHTML = `<iframe src="${driveUrl}" class="absolute inset-0 w-full h-full border-0 z-10" allow="autoplay"></iframe>`;
                } else {
                    playerHTML = `<video loop playsinline controls class="absolute inset-0 w-full h-full object-cover z-10 bg-black"><source src="${url}" type="video/mp4"></video>`;
                }

                return `
                    <div class="reel-card relative w-full h-[calc(100vh-160px)] md:h-[750px] bg-black rounded-3xl overflow-hidden border border-brand-border shadow-2xl flex flex-col justify-end" data-index="${index}">
                        ${playerHTML}
                        
                        <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-transparent to-black/90 pointer-events-none z-15"></div>

                        <div class="absolute right-3 bottom-16 flex flex-col items-center gap-5 z-30" onclick="event.stopPropagation()">
                            <button onclick="rewardShortView(this)" class="short-reward-btn w-12 h-12 rounded-full glass-panel border border-white/20 bg-black/50 flex flex-col items-center justify-center text-gray-400 cursor-pointer z-30 opacity-80">
                                <i class="fas fa-lock text-xs"></i>
                                <span class="text-[8px] font-bold">0/2</span>
                            </button>

                            <button onclick="shareMovie()" class="flex flex-col items-center gap-1 text-white">
                                <div class="w-11 h-11 rounded-full glass-panel flex items-center justify-center text-lg">
                                    <i class="fas fa-share"></i>
                                </div>
                                <span class="text-[10px] font-bold">Share</span>
                            </button>
                        </div>

                        <div class="relative z-30 p-5 space-y-1 pointer-events-none">
                            <span class="font-bold text-sm text-white">${short.creator}</span>
                            <p class="text-xs text-gray-200 line-clamp-2">${short.title}</p>
                        </div>
                    </div>
                `;
            }).join('');

            updateShortRewardUI();
        }

        function handleShortsScroll() {
            const feed = document.getElementById('reels-feed');
            const cardHeight = feed.clientHeight;
            const currentScroll = feed.scrollTop;

            if (Math.abs(currentScroll - lastScrollTop) >= cardHeight * 0.7) {
                lastScrollTop = currentScroll;
                shortsWatchedCount++;
                updateShortRewardUI();
            }
        }

        function updateShortRewardUI() {
            const rewardBtns = document.querySelectorAll('.short-reward-btn');
            rewardBtns.forEach(btn => {
                if (shortsWatchedCount >= 2) {
                    btn.className = "short-reward-btn w-12 h-12 rounded-full glass-panel border border-brand-gold bg-brand-gold/20 flex flex-col items-center justify-center text-brand-gold animate-bounce shadow-lg shadow-yellow-500/50 cursor-pointer z-30";
                    btn.innerHTML = `<i class="fas fa-coins text-sm"></i><span class="text-[8px] font-black">+100</span>`;
                } else {
                    btn.className = "short-reward-btn w-12 h-12 rounded-full glass-panel border border-white/20 bg-black/50 flex flex-col items-center justify-center text-gray-400 cursor-pointer z-30 opacity-80";
                    btn.innerHTML = `<i class="fas fa-lock text-xs"></i><span class="text-[8px] font-bold">${shortsWatchedCount}/2</span>`;
                }
            });
        }

        async function rewardShortView(btn) {
            if (shortsWatchedCount < 2) {
                showToast(`🔒 Watch 2 short videos to unlock reward! (${shortsWatchedCount}/2 watched)`);
                return;
            }

            shortsWatchedCount = 0;
            updateShortRewardUI();

            await addCoins(100);
            showToast('🎉 Unlocked +100 Coins! Watch 2 more shorts for next reward.');
        }

        function selectWithdrawCard(el, rupees, coinsReq) {
            document.querySelectorAll('.withdraw-card').forEach(card => card.classList.remove('withdraw-card-active'));
            el.classList.add('withdraw-card-active');
            selectedRupees = rupees;
            selectedCoinsReq = coinsReq;
        }

        function openWithdrawModal() {
            document.getElementById('modal-amount-text').textContent = `₹${selectedRupees}`;
            document.getElementById('modal-coins-text').textContent = `${selectedCoinsReq.toLocaleString()} Coins`;
            document.getElementById('withdraw-modal').classList.remove('hidden');
        }

        function closeWithdrawModal() { document.getElementById('withdraw-modal').classList.add('hidden'); }

        async function submitWithdrawal() {
            const upiVal = document.getElementById('upi-input').value.trim();
            if (!upiVal) {
                showToast('Enter your UPI ID or Paytm number!');
                return;
            }

            if (coins < selectedCoinsReq) {
                const diff = selectedCoinsReq - coins;
                showToast(`Need ${diff.toLocaleString()} more coins for ₹${selectedRupees}.`);
                closeWithdrawModal();
                return;
            }

            try {
                await _supabase.from('withdrawals').insert([{
                    user_id: userId,
                    amount_inr: selectedRupees,
                    coins_used: selectedCoinsReq,
                    payment_info: upiVal,
                    status: 'Pending'
                }]);
            } catch (err) {
                console.error("Withdrawal exception:", err);
            }

            coins -= selectedCoinsReq;
            totalWithdrawn += selectedRupees;
            updateUI();
            await updateDBCoins();

            closeWithdrawModal();
            showToast(`🎉 ₹${selectedRupees} withdrawal request sent to Admin!`);
            document.getElementById('upi-input').value = '';
        }

        function getYouTubeId(url) {
            if (!url) return null;
            const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|shorts\/|watch\?v=|\&v=)([^#\&\?]*).*/;
            const match = url.match(regExp);
            return (match && match[2].length === 11) ? match[2] : null;
        }

        function getDailymotionId(url) {
            if (!url) return null;
            const regExp = /^.+dailymotion.com\/(video|hub)\/([^_]+)[^#]*$/;
            const match = url.match(regExp);
            if (match && match[2]) return match[2];
            const shortMatch = url.match(/^.+dai.ly\/([^_]+)[^#]*$/);
            return shortMatch ? shortMatch[1] : null;
        }

        function getPosterUrl(m) {
            if (m.poster_url && m.poster_url.trim() !== "") return m.poster_url;
            const ytId = getYouTubeId(m.video_url);
            if (ytId) return `https://img.youtube.com/vi/${ytId}/hqdefault.jpg`;
            const dmId = getDailymotionId(m.video_url);
            if (dmId) return `https://www.dailymotion.com/thumbnail/video/${dmId}`;
            return "https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=800";
        }

        async function fetchUserCoins() {
            try {
                let { data, error } = await _supabase.from('profiles').select('coins').eq('id', userId).single();
                if (error && error.code === 'PGRST116') {
                    await _supabase.from('profiles').insert([{ id: userId, coins: 108176 }]);
                    coins = 108176;
                } else if (data) {
                    coins = data.coins || 108176;
                }
            } catch (err) { coins = 108176; }
            updateUI();
        }

        async function updateDBCoins() {
            try { await _supabase.from('profiles').update({ coins: coins }).eq('id', userId); } catch (e) {}
        }

        function updateUI() {
            const formatted = coins.toLocaleString();
            const rupees = (coins / 10000).toFixed(2);

            document.getElementById('user-coins-header').textContent = formatted;
            document.getElementById('user-coins-desktop').textContent = formatted;
            document.getElementById('user-rupees-desktop').textContent = rupees;
            document.getElementById('menu-coins').textContent = formatted;
            document.getElementById('menu-rupees').textContent = rupees;
            document.getElementById('rank-coins').textContent = formatted;

            document.getElementById('wallet-coins-count').textContent = formatted;
            document.getElementById('wallet-rupees-count').textContent = rupees;
            document.getElementById('total-withdrawn-text').textContent = `₹ ${totalWithdrawn.toFixed(2)}`;
        }

        async function addCoins(amount) {
            coins += amount;
            if (coins < 0) coins = 0;
            updateUI();
            await updateDBCoins();
        }

        async function loadMoviesFromDB() {
            try {
                let { data } = await _supabase.from('movies').select('*').order('created_at', { ascending: false });
                if (data && data.length > 0) {
                    allMoviesList = data;
                } else {
                    allMoviesList = [
                        {
                            title: "Hero (Full Movie)",
                            year: "2024",
                            genre: "Action, Drama",
                            poster_url: "https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=800",
                            video_url: "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4"
                        }
                    ];
                }
            } catch (e) { console.error(e); }

            currentMovie = allMoviesList[0];
            loadTopMovieUI();
            renderMoviesGrid();
        }

        async function loadShortsFromDB() {
            try {
                let { data } = await _supabase.from('shorts').select('*').order('created_at', { ascending: false });
                if (data && data.length > 0) {
                    allShortsList = data;
                } else {
                    allShortsList = defaultShorts;
                }
            } catch (e) {
                allShortsList = defaultShorts;
            }
        }

        function loadTopMovieUI() {
            document.getElementById('top-movie-title').textContent = currentMovie.title;
            document.getElementById('top-movie-year').textContent = currentMovie.year || "2024";
            document.getElementById('top-movie-genre').textContent = currentMovie.genre || "Action";
            document.getElementById('top-poster-img').src = getPosterUrl(currentMovie);
            document.getElementById('video-placeholder').classList.remove('hidden');
            document.getElementById('player-mount').innerHTML = '';
            if (watchTimerInterval) clearInterval(watchTimerInterval);
        }

        function startCurrentVideo() {
            document.getElementById('video-placeholder').classList.add('hidden');
            const mount = document.getElementById('player-mount');
            const url = currentMovie.video_url || "";

            const ytId = getYouTubeId(url);
            const dmId = getDailymotionId(url);

            if (dmId) {
                mount.innerHTML = `<iframe src="https://www.dailymotion.com/embed/video/${dmId}?autoplay=1&ui-logo=0" allow="autoplay; fullscreen" class="w-full h-full rounded-xl border-0"></iframe>`;
            } else if (url.includes('drive.google.com')) {
                let driveUrl = url.replace('/view', '/preview');
                mount.innerHTML = `<iframe src="${driveUrl}" class="w-full h-full rounded-xl border-0" allow="autoplay" allowfullscreen></iframe>`;
            } else if (ytId) {
                const currentOrigin = (window.location.origin && window.location.origin !== "null") ? window.location.origin : "https://www.youtube.com";
                mount.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1&rel=0&origin=${encodeURIComponent(currentOrigin)}" allow="autoplay; encrypted-media" allowfullscreen class="w-full h-full rounded-xl border-0"></iframe>`;
            } else {
                mount.innerHTML = `<video controls autoplay playsinline class="w-full h-full rounded-xl object-cover"><source src="${url}" type="video/mp4"></video>`;
            }

            if (watchTimerInterval) clearInterval(watchTimerInterval);
            watchTimerInterval = setInterval(() => {
                totalWatchedSeconds++;
                updateWatchTimelineUI();
                saveWatchProgress(); // Persistent save progress
            }, 1000);
        }

        function updateWatchTimelineUI() {
            const mins = Math.floor(totalWatchedSeconds / 60);
            const secs = totalWatchedSeconds % 60;
            document.getElementById('watch-time-text').textContent = `${mins} mins ${secs}s watched`;

            const progressPercent = Math.min(100, (totalWatchedSeconds / 10800) * 100);
            document.getElementById('milestone-progress-line').style.width = Math.max(2, progressPercent) + '%';

            milestones.forEach((m) => {
                const dotEl = document.getElementById(`m-dot-${m.id}`);
                if (m.claimed) {
                    dotEl.className = "w-6 h-6 rounded-full bg-green-500 text-white border-2 border-green-400 flex items-center justify-center text-[10px] font-bold";
                    dotEl.innerHTML = `<i class="fas fa-check"></i>`;
                } else if (totalWatchedSeconds >= m.seconds) {
                    dotEl.className = "w-6 h-6 rounded-full bg-brand-gold text-black border-2 border-yellow-300 flex items-center justify-center text-[10px] font-extrabold animate-bounce shadow-lg shadow-yellow-500/50";
                    dotEl.innerHTML = `<i class="fas fa-unlock"></i>`;
                } else {
                    dotEl.className = "w-6 h-6 rounded-full bg-brand-card border-2 border-gray-600 flex items-center justify-center text-[10px] text-white font-bold";
                    dotEl.innerHTML = `<i class="fas fa-lock text-[8px]"></i>`;
                }
            });
        }

        async function claimMilestone(index) {
            const m = milestones[index];
            if (totalWatchedSeconds < m.seconds) {
                showToast(`Watch ${m.mins} mins to unlock +${m.reward.toLocaleString()} Coins!`);
                return;
            }
            if (m.claimed) {
                showToast(`Already claimed +${m.reward.toLocaleString()} Coins!`);
                return;
            }

            m.claimed = true;
            await addCoins(m.reward);
            saveWatchProgress(); // Save updated claim state
            
            updateWatchTimelineUI();
            showToast(`🎉 Unlocked +${m.reward.toLocaleString()} Coins!`);
        }

        function simulateWatchTime(secs) {
            totalWatchedSeconds += secs;
            updateWatchTimelineUI();
            saveWatchProgress();
            showToast(`Watch time boosted +${secs/60} mins!`);
        }

        // TAPPING MOVIE CARD PLAYS VIDEO & SCROLLS TO TOP CONTAINER!
        function playSelectedMovie(index) {
            currentMovie = allMoviesList[index];
            loadTopMovieUI();
            startCurrentVideo();
            
            // FIX: Smooth Scroll to top of main content container
            const mainScroll = document.getElementById('main-scroll-container');
            if (mainScroll) {
                mainScroll.scrollTo({ top: 0, behavior: 'smooth' });
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });

            showToast(`🎬 Playing: ${currentMovie.title}`);
        }

        function renderMoviesGrid() {
            const grid = document.getElementById('movies-grid');
            grid.innerHTML = allMoviesList.map((m, index) => {
                const thumbnail = getPosterUrl(m);
                return `
                    <div class="card-hover cursor-pointer group bg-brand-card border border-brand-border/80 hover:border-brand-red/50 rounded-2xl p-2.5 transition-all duration-300 shadow-lg" onclick="playSelectedMovie(${index})">
                        <div class="relative aspect-[2/3] overflow-hidden rounded-xl bg-gray-900">
                            <img src="${thumbnail}" alt="${m.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                                <div class="w-10 h-10 rounded-full bg-brand-red flex items-center justify-center text-white text-sm shadow-xl glow-red transform group-hover:scale-110 transition-transform">
                                    <i class="fas fa-play ml-0.5"></i>
                                </div>
                            </div>
                            <span class="absolute top-2 left-2 bg-brand-red/90 text-white text-[9px] font-extrabold px-2 py-0.5 rounded-md shadow backdrop-blur-md">HD</span>
                        </div>
                        <div class="mt-2.5 px-1">
                            <h3 class="text-xs font-bold truncate text-white group-hover:text-brand-red transition">${m.title}</h3>
                            <p class="text-[10px] text-gray-400 mt-0.5 font-medium">${m.year || '2024'} • ${m.genre || 'Cinema'}</p>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function toggleLike() { showToast('Added to liked movies!'); }
        function shareMovie() { showToast('Invite link copied!'); }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').textContent = msg;
            toast.classList.remove('hidden');
            setTimeout(() => toast.classList.add('hidden'), 3000);
        }

        window.onload = () => {
            fetchUserCoins();
            loadSavedWatchProgress(); // Restores time, claimed status & checks 3h reset
            loadMoviesFromDB();
            loadShortsFromDB();
        };
    </script>
</body>
</html>
