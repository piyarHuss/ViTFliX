<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>VitFlix Premium - Movies, Shorts & Cash Wallet</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Supabase JS SDK -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            red: '#E50914',
                            dark: '#08080a',
                            card: '#121217',
                            border: '#22222a',
                            gold: '#FFD700'
                        }
                    }
                }
            }
        }
    </script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

        * {
            font-family: 'Plus Jakarta Sans', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: #08080a;
            color: #ffffff;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #08080a; }
        ::-webkit-scrollbar-thumb { background: #22222a; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #E50914; }

        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        /* Reels Snap Scroll */
        .reels-container {
            scroll-snap-type: y mandatory;
            overflow-y: scroll;
            height: calc(100vh - 140px);
        }
        @media (min-width: 768px) {
            .reels-container { height: 750px; }
        }

        .reel-card {
            scroll-snap-align: start;
            scroll-snap-stop: always;
        }

        .glass-panel {
            background: rgba(18, 18, 23, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .glow-red { box-shadow: 0 0 25px rgba(229, 9, 20, 0.35); }

        .coin-spin { animation: spin 4s linear infinite; }
        @keyframes spin { 0% { transform: rotateY(0deg); } 100% { transform: rotateY(360deg); } }

        .video-container {
            position: relative;
            padding-bottom: 56.25%;
            height: 0;
            overflow: hidden;
            border-radius: 16px;
            transition: all 0.3s ease;
        }
        .video-container iframe, .video-container video {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none;
        }

        .fullscreen-active {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            z-index: 99999 !important;
            border-radius: 0 !important;
            padding-bottom: 0 !important;
            background: #000 !important;
        }

        .card-hover { transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
        .card-hover:hover { transform: translateY(-6px) scale(1.02); box-shadow: 0 15px 30px rgba(229, 9, 20, 0.3); }

        .toast-animate { animation: slideUp 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
        @keyframes slideUp {
            from { transform: translateY(100%) translateX(-50%); opacity: 0; }
            to { transform: translateY(0) translateX(-50%); opacity: 1; }
        }

        .withdraw-card-active {
            border-color: #E50914 !important;
            background-color: rgba(229, 9, 20, 0.08) !important;
            box-shadow: 0 0 15px rgba(229, 9, 20, 0.2);
        }
    </style>
</head>
<body class="min-h-screen pb-16 md:pb-0">

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-20 md:bottom-8 left-1/2 -translate-x-1/2 z-[150000] hidden">
        <div class="glass-panel text-white px-6 py-3 rounded-2xl shadow-2xl flex items-center gap-3 border-brand-red/40 border toast-animate">
            <i class="fas fa-coins text-brand-gold text-lg"></i>
            <span id="toast-msg" class="text-sm font-semibold">Reward claimed successfully!</span>
        </div>
    </div>

    <!-- SIDE DRAWER MENU -->
    <div id="menu-drawer" class="fixed inset-0 bg-black/80 z-[120] hidden backdrop-blur-sm" onclick="closeDrawerMenu()">
        <div class="w-72 max-w-[80%] h-full bg-[#121217] border-r border-brand-border p-5 space-y-6 flex flex-col justify-between" onclick="event.stopPropagation()">
            <div class="space-y-6">
                <div class="flex items-center justify-between pb-4 border-b border-white/10">
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-brand-red to-orange-500 flex items-center justify-center glow-red">
                            <i class="fas fa-play text-white text-xs"></i>
                        </div>
                        <span class="text-xl font-black">Vit<span class="text-brand-red">Flix</span></span>
                    </div>
                    <button onclick="closeDrawerMenu()" class="text-gray-400 hover:text-white p-1 text-lg"><i class="fas fa-times"></i></button>
                </div>

                <nav class="space-y-2">
                    <button onclick="switchView('movies'); closeDrawerMenu();" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl font-semibold text-sm transition text-white hover:bg-brand-red">
                        <i class="fas fa-film text-brand-red text-base w-5"></i>
                        <span>Movies & Cinema</span>
                    </button>
                    <button onclick="switchView('shorts'); closeDrawerMenu();" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl font-semibold text-sm transition text-white hover:bg-brand-red">
                        <i class="fas fa-bolt text-brand-gold text-base w-5"></i>
                        <span>Shorts Videos</span>
                    </button>
                    <button onclick="switchView('cash'); closeDrawerMenu();" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl font-semibold text-sm transition text-white hover:bg-brand-red">
                        <i class="fas fa-wallet text-green-400 text-base w-5"></i>
                        <span>Cash / My Wallet</span>
                    </button>
                </nav>
            </div>

            <div class="glass-panel p-4 rounded-2xl border border-brand-gold/20 space-y-2">
                <div class="text-xs text-gray-400">Total Wallet Coins</div>
                <div class="flex items-center gap-2">
                    <i class="fas fa-coins text-brand-gold text-xl coin-spin"></i>
                    <span id="menu-coins" class="text-xl font-extrabold text-white">108,176</span>
                </div>
                <p class="text-[11px] text-brand-gold font-bold">≈ ₹ <span id="menu-rupees">10.82</span> INR</p>
            </div>
        </div>
    </div>

    <!-- WITHDRAWAL RECORD MODAL -->
    <div id="records-modal" class="fixed inset-0 bg-black/85 z-[140] flex items-center justify-center p-4 hidden backdrop-blur-md">
        <div class="bg-[#121217] border border-brand-border w-full max-w-md rounded-2xl p-6 space-y-4 max-h-[80vh] flex flex-col shadow-2xl">
            <div class="flex items-center justify-between border-b border-white/10 pb-3">
                <h3 class="text-base font-bold text-white flex items-center gap-2">
                    <i class="fas fa-history text-brand-gold"></i> Withdrawal Record
                </h3>
                <button onclick="closeRecordsModal()" class="text-gray-400 hover:text-white p-1"><i class="fas fa-times"></i></button>
            </div>

            <div id="records-list" class="space-y-3 overflow-y-auto no-scrollbar flex-1 pr-1">
                <!-- Records loaded via JS -->
            </div>
        </div>
    </div>

    <!-- WITHDRAWAL SUBMIT MODAL -->
    <div id="withdraw-modal" class="fixed inset-0 bg-black/80 z-[130] flex items-center justify-center p-4 hidden backdrop-blur-sm">
        <div class="bg-[#121217] border border-brand-border w-full max-w-md rounded-2xl p-6 space-y-5">
            <div class="flex items-center justify-between border-b border-white/10 pb-3">
                <h3 class="text-lg font-bold text-white flex items-center gap-2">
                    <i class="fas fa-wallet text-brand-red"></i> Confirm Withdrawal
                </h3>
                <button onclick="closeWithdrawModal()" class="text-gray-400 hover:text-white"><i class="fas fa-times"></i></button>
            </div>

            <div class="bg-brand-red/10 border border-brand-red/30 rounded-xl p-3 text-xs text-brand-gold space-y-1">
                <p class="font-bold">Amount: <span id="modal-amount-text" class="text-white">₹10</span></p>
                <p class="font-bold">Required: <span id="modal-coins-text" class="text-white">100,000 Coins</span></p>
            </div>

            <div class="space-y-3">
                <label class="text-xs text-gray-300 font-semibold">Enter UPI ID / Paytm Phone Number</label>
                <input type="text" id="upi-input" placeholder="e.g. 9876543210@paytm" class="w-full bg-black/60 border border-brand-border rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-brand-red">
            </div>

            <button onclick="submitWithdrawal()" class="w-full bg-gradient-to-r from-red-600 to-rose-600 text-white font-bold py-3.5 rounded-xl text-sm shadow-lg hover:brightness-110 transition">
                Submit Request
            </button>
        </div>
    </div>

    <!-- MAIN APP STRUCTURE -->
    <div class="flex h-screen overflow-hidden">

        <!-- DESKTOP SIDEBAR NAVIGATION -->
        <aside class="hidden md:flex flex-col w-64 border-r border-brand-border bg-brand-dark p-5 justify-between">
            <div class="space-y-8">
                <div class="flex items-center gap-3 px-2 cursor-pointer" onclick="switchView('movies')">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-red to-orange-500 flex items-center justify-center glow-red">
                        <i class="fas fa-play text-white text-lg"></i>
                    </div>
                    <span class="text-2xl font-black tracking-tight">Vit<span class="text-brand-red">Flix</span></span>
                </div>

                <nav class="space-y-2">
                    <button onclick="switchView('movies')" id="nav-movies-btn" class="w-full flex items-center gap-4 px-4 py-3 rounded-xl font-semibold text-sm transition bg-brand-red text-white">
                        <i class="fas fa-film text-lg"></i>
                        <span>Movies</span>
                    </button>
                    <button onclick="switchView('shorts')" id="nav-shorts-btn" class="w-full flex items-center gap-4 px-4 py-3 rounded-xl font-semibold text-sm transition text-gray-400 hover:text-white hover:bg-brand-card">
                        <i class="fas fa-bolt text-lg text-brand-gold"></i>
                        <span>Shorts</span>
                    </button>
                    <button onclick="switchView('cash')" id="nav-cash-btn" class="w-full flex items-center gap-4 px-4 py-3 rounded-xl font-semibold text-sm transition text-gray-400 hover:text-white hover:bg-brand-card">
                        <i class="fas fa-wallet text-lg text-green-400"></i>
                        <span>Cash Wallet</span>
                    </button>
                </nav>
            </div>

            <div class="glass-panel p-4 rounded-2xl border border-brand-gold/20 space-y-3 cursor-pointer" onclick="switchView('cash')">
                <div class="flex items-center justify-between text-xs text-gray-400 font-medium">
                    <span>Total Cash Balance</span>
                    <i class="fas fa-chevron-right text-xs"></i>
                </div>
                <div class="flex items-center gap-2">
                    <i class="fas fa-coins text-brand-gold text-2xl coin-spin"></i>
                    <span id="user-coins-desktop" class="text-2xl font-extrabold text-white">108,176</span>
                </div>
                <p class="text-[11px] text-brand-gold font-bold">≈ ₹ <span id="user-rupees-desktop">10.82</span> INR</p>
            </div>
        </aside>

        <!-- MAIN CONTENT AREA (ADDED ID FOR SCROLL FIX) -->
        <div id="main-scroll-container" class="flex-1 flex flex-col h-screen overflow-y-auto no-scrollbar">

            <!-- CLEAN TOP NAVBAR -->
            <header class="sticky top-0 z-40 glass-panel border-b border-brand-border px-4 py-3.5 md:px-8 flex items-center justify-between">
                
                <div class="flex items-center gap-3">
                    <button onclick="openDrawerMenu()" class="w-9 h-9 rounded-xl bg-white/10 flex items-center justify-center text-white hover:bg-brand-red transition">
                        <i class="fas fa-bars text-lg"></i>
                    </button>
                    
                    <div class="flex items-center gap-2 cursor-pointer" onclick="switchView('movies')">
                        <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-brand-red to-orange-500 flex items-center justify-center">
                            <i class="fas fa-play text-white text-xs"></i>
                        </div>
                        <span class="text-xl font-black">Vit<span class="text-brand-red">Flix</span></span>
                    </div>
                </div>

                <div onclick="switchView('cash')" class="flex items-center gap-2 bg-brand-gold/10 border border-brand-gold/30 px-3 py-1.5 rounded-full cursor-pointer">
                    <i class="fas fa-coins text-brand-gold coin-spin text-sm"></i>
                    <span id="user-coins-header" class="text-brand-gold font-bold text-xs md:text-sm">108,176</span>
                </div>
            </header>


            <!-- ================= VIEW 1: MOVIES SECTION ================= -->
            <main id="view-movies" class="p-4 md:p-8 space-y-8 max-w-7xl mx-auto w-full">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="lg:col-span-2 space-y-4">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <div>
                                <h1 id="top-movie-title" class="text-xl md:text-2xl font-extrabold text-white">Loading Movie...</h1>
                                <div class="flex items-center gap-2 mt-1 text-xs text-gray-400">
                                    <span class="bg-brand-red text-white text-[10px] font-extrabold px-2 py-0.5 rounded">FULL HD</span>
                                    <span id="top-movie-year">2024</span>
                                    <span>•</span>
                                    <span id="top-movie-genre" class="text-brand-gold font-semibold">Action, Drama</span>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <button onclick="toggleLike()" class="glass-panel hover:bg-white/10 px-3 py-1.5 rounded-xl transition text-xs font-semibold">
                                    <i class="far fa-heart text-brand-red mr-1"></i> 24.5K
                                </button>
                                <button onclick="shareMovie()" class="glass-panel hover:bg-white/10 px-3 py-1.5 rounded-xl transition text-xs font-semibold">
                                    <i class="fas fa-share-alt text-gray-300 mr-1"></i> Share
                                </button>
                            </div>
                        </div>

                        <!-- Video Player Box -->
                        <div class="video-container glow-red relative border border-brand-border bg-black rounded-2xl overflow-hidden shadow-2xl" id="video-wrapper">
                            
                            <button onclick="makeVideoFullScreen()" title="Full Screen" class="absolute top-3 right-3 z-40 w-9 h-9 rounded-full bg-black/70 hover:bg-brand-red border border-white/20 text-brand-gold flex items-center justify-center text-sm backdrop-blur-md shadow-2xl transition active:scale-95">
                                <i id="fs-btn-icon" class="fas fa-expand"></i>
                            </button>

                            <div id="video-placeholder" class="absolute inset-0 flex flex-col items-center justify-center bg-black/80 rounded-xl z-10 cursor-pointer" onclick="startCurrentVideo()">
                                <img id="top-poster-img" src="" alt="Poster" class="absolute inset-0 w-full h-full object-cover opacity-30">
                                <div class="relative z-10 flex flex-col items-center p-4 text-center">
                                    <div class="w-16 h-16 md:w-20 md:h-20 rounded-full bg-brand-red flex items-center justify-center mb-3 hover:scale-110 transition shadow-2xl glow-red">
                                        <i class="fas fa-play text-white text-2xl md:text-3xl ml-1"></i>
                                    </div>
                                    <p class="text-white font-bold text-base md:text-lg">Click to Play Stream</p>
                                    <p class="text-brand-gold text-xs mt-1 font-semibold flex items-center gap-1">
                                        <i class="fas fa-coins"></i> Watch & Automatically Earn Coins
                                    </p>
                                </div>
                            </div>
                            <div id="player-mount" class="w-full h-full"></div>
                        </div>

                        <!-- Watch Time Timeline -->
                        <div class="glass-panel rounded-2xl p-4 md:p-6 border border-brand-gold/30 space-y-4">
                            <div class="bg-brand-gold/10 border border-brand-gold/20 rounded-xl px-3 py-2 flex items-center gap-2 text-xs text-brand-gold">
                                <i class="fas fa-volume-high animate-pulse"></i>
                                <div class="truncate font-medium flex-1">
                                    <span id="payout-ticker">🔥 MP**MU successfully withdrew ₹50 via UPI (Just now)</span>
                                </div>
                            </div>

                            <div class="flex justify-between items-center text-xs font-bold">
                                <span class="flex items-center gap-2"><i class="fas fa-stopwatch text-brand-red"></i> Watch Time Rewards Timeline</span>
                                <span id="watch-time-text" class="text-brand-gold">0 mins watched</span>
                            </div>

                            <div class="relative py-2">
                                <div class="absolute top-1/2 left-0 right-0 h-2 bg-white/5 -translate-y-1/2 rounded-full overflow-hidden">
                                    <div id="milestone-progress-line" class="h-full bg-gradient-to-r from-brand-gold to-brand-red transition-all duration-500" style="width: 0%"></div>
                                </div>

                                <div class="relative flex justify-between items-center z-10 text-center">
                                    <div class="flex flex-col items-center cursor-pointer" onclick="claimMilestone(0)">
                                        <span class="text-[9px] font-extrabold text-brand-gold bg-black/90 px-1.5 py-0.5 rounded border border-brand-gold/30 mb-1.5">+800</span>
                                        <div id="m-dot-0" class="w-6 h-6 rounded-full bg-brand-card border-2 border-gray-600 flex items-center justify-center text-[10px] text-white font-bold"><i class="fas fa-lock text-[8px]"></i></div>
                                        <span class="text-[10px] text-gray-400 font-semibold mt-1">2m</span>
                                    </div>
                                    <div class="flex flex-col items-center cursor-pointer" onclick="claimMilestone(1)">
                                        <span class="text-[9px] font-extrabold text-brand-gold bg-black/90 px-1.5 py-0.5 rounded border border-brand-gold/30 mb-1.5">+2K</span>
                                        <div id="m-dot-1" class="w-6 h-6 rounded-full bg-brand-card border-2 border-gray-600 flex items-center justify-center text-[10px] text-white font-bold"><i class="fas fa-lock text-[8px]"></i></div>
                                        <span class="text-[10px] text-gray-400 font-semibold mt-1">10m</span>
                                    </div>
                                    <div class="flex flex-col items-center cursor-pointer" onclick="claimMilestone(2)">
                                        <span class="text-[9px] font-extrabold text-brand-gold bg-black/90 px-1.5 py-0.5 rounded border border-brand-gold/30 mb-1.5">+4K</span>
                                        <div id="m-dot-2" class="w-6 h-6 rounded-full bg-brand-card border-2 border-gray-600 flex items-center justify-center text-[10px] text-white font-bold"><i class="fas fa-lock text-[8px]"></i></div>
                                        <span class="text-[10px] text-gray-400 font-semibold mt-1">20m</span>
                                    </div>
                                    <div class="flex flex-col items-center cursor-pointer" onclick="claimMilestone(3)">
                                        <span class="text-[9px] font-extrabold text-brand-gold bg-black/90 px-1.5 py-0.5 rounded border border-brand-gold/30 mb-1.5">+6K</span>
                                        <div id="m-dot-3" class="w-6 h-6 rounded-full bg-brand-card border-2 border-gray-600 flex items-center justify-center text-[10px] text-white font-bold"><i class="fas fa-lock text-[8px]"></i></div>
                                        <span class="text-[10px] text-gray-400 font-semibold mt-1">30m</span>
                                    </div>
                                    <div class="flex flex-col items-center cursor-pointer" onclick="claimMilestone(4)">
                                        <span class="text-[9px] font-extrabold text-brand-gold bg-black/90 px-1.5 py-0.5 rounded border border-brand-gold/30 mb-1.5">+10K</span>
                                        <div id="m-dot-4" class="w-6 h-6 rounded-full bg-brand-card border-2 border-gray-600 flex items-center justify-center text-[10px] text-white font-bold"><i class="fas fa-lock text-[8px]"></i></div>
                                        <span class="text-[10px] text-gray-400 font-semibold mt-1">60m</span>
                                    </div>
                                    <div class="flex flex-col items-center cursor-pointer" onclick="claimMilestone(5)">
                                        <span class="text-[9px] font-extrabold text-brand-gold bg-black/90 px-1.5 py-0.5 rounded border border-brand-gold/30 mb-1.5">+16K</span>
                                        <div id="m-dot-5" class="w-6 h-6 rounded-full bg-brand-card border-2 border-gray-600 flex items-center justify-center text-[10px] text-white font-bold"><i class="fas fa-lock text-[8px]"></i></div>
                                        <span class="text-[10px] text-gray-400 font-semibold mt-1">180m</span>
                                    </div>
                                </div>
                            </div>

                            <div class="pt-2 border-t border-white/5 flex items-center justify-between text-xs text-gray-400">
                                <span>Watch time updates every second</span>
                                <button onclick="simulateWatchTime(120)" class="text-brand-gold font-bold text-xs hover:underline flex items-center gap-1">
                                    <i class="fas fa-bolt"></i> Speed Test (+2m)
                                </button>
                            </div>
                        </div>

                    </div>

                    <!-- Right Sidebar -->
                    <div class="space-y-6">
                        <div class="glass-panel rounded-2xl p-5 border border-brand-border">
                            <h3 class="font-bold text-base mb-4 flex items-center gap-2 text-white">
                                <i class="fas fa-server text-brand-red"></i> Streaming CDN Server
                            </h3>
                            <button class="w-full text-left px-4 py-3 rounded-xl bg-brand-red/10 border border-brand-red/30 text-xs font-semibold flex items-center justify-between">
                                <span class="flex items-center gap-2"><i class="fas fa-play-circle text-brand-red"></i> High Speed Stream</span>
                                <span class="bg-green-500/20 text-green-400 px-2 py-0.5 rounded-full text-[10px] font-bold">Online</span>
                            </button>
                        </div>

                        <div class="glass-panel rounded-2xl p-5 border border-brand-gold/20">
                            <h3 class="font-bold text-base mb-4 flex items-center gap-2 text-white">
                                <i class="fas fa-trophy text-brand-gold"></i> Top Earners Today
                            </h3>
                            <div class="space-y-3">
                                <div class="flex items-center gap-3 text-xs">
                                    <span class="text-brand-gold font-bold w-4">1</span>
                                    <span class="flex-1 font-medium">Ravi_King</span>
                                    <span class="text-brand-gold font-bold">152,800</span>
                                </div>
                                <div class="flex items-center gap-3 text-xs">
                                    <span class="text-gray-400 font-bold w-4">2</span>
                                    <span class="flex-1 font-medium">Sneha_M</span>
                                    <span class="text-brand-gold font-bold">128,400</span>
                                </div>
                                <div class="flex items-center gap-3 text-xs bg-brand-red/10 border border-brand-red/20 p-2.5 rounded-xl">
                                    <span class="text-brand-red font-bold w-4">42</span>
                                    <span class="flex-1 font-bold">You (Current User)</span>
                                    <span class="text-brand-gold font-extrabold" id="rank-coins">108,176</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- MOVIE CARDS GRID SECTION -->
                <section class="space-y-5 pt-4">
                    <div class="flex items-center justify-between">
